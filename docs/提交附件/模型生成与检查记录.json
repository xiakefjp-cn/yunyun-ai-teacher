    "items": [
      {
        "id": "lesson",
        "kind": "lesson",
        "title": "循环结构：让重复有边界",
        "objectives": [
          "追踪循环变量变化，判断终止条件",
          "用 for 和 while 解决计数与累加问题",
          "通过零次、一次、多次循环用例解释程序结果"
        ],
        "prerequisites": [
          "变量与输入输出",
          "条件语句"
        ],
        "segments": [
          {
            "title": "前置诊断与补齐",
            "minutes": 7,
            "activity": "5人未交：先做2道条件语句口头诊断（如输入a,b，输出较大值；输入x，若x>0输出'正'否则输出'非正'），不推定为不会；同伴讲解输入与判断。"
          },
          {
            "title": "示范与追踪",
            "minutes": 12,
            "activity": "扫地机器人引入：'每次前进10步，重复10次，共走多少步？'——强调累计100步，非总共10步；手写变量追踪表（n,i,position或s,count）后运行；六边形改错：给出错误代码（右转60度在for外），让学生指出为何n=6时只转一次；纸上流程图：画菱形判断框+两条分支线（是→循环体→回菱形，否→退出），人工审核文字描述与图形是否对应。"
          },
          {
            "title": "分层练习",
            "minutes": 15,
            "activity": "基础：检查for循环内是否完整包含'移动10步'和'右转60度'两行；进阶：检查while中i是否初始化、条件是否含<=、更新是否在循环体内；挑战：检查循环条件是否为s<target、更新顺序是否先i+=1再s+=10、是否处理n=0。逐个检查边界用例输出。"
          },
          {
            "title": "退出条与反馈",
            "minutes": 6,
            "activity": "写出 while 三要素（初始化、条件、更新）；解释 n=0 时所有程序输出为空或0的原因；正方形题澄清：若比'执行次数'，A=10、B=5、C=3；若比'不同位置/方向的图形数量'，须明确定义重叠即相同、角度差≥30°算不同，原文B不能直接判对。"
          }
        ],
        "teacher_review": [
          "课程标准与课堂节奏仍由老师判断",
          "测试通过只说明已测输入一致；人工核对参考答案、测试期望和难度",
          "正方形题若比较调用次数是10/5/3；若比较不同图形须先明确重叠与位置方向标准，原文不能直接判B",
          "10次移动10步累计100步，非总共10步",
          "所有几何活动仅输出指令文本，未执行Scratch或图形库验证"
        ],
        "stage": "初中"
      },
      {
        "id": "example_for",
        "title": "演示1：机器人重复前进",
        "kind": "example",
        "code": "n = int(input())\nposition = 0\nfor i in range(n):\n    position += 10\n    print(position)\n",
        "tests": [
          {
            "stdin": "0",
            "expected": ""
          },
          {
            "stdin": "1",
            "expected": "10"
          },
          {
            "stdin": "3",
            "expected": "10\n20\n30"
          }
        ],
        "explanation": "range(n)生成0至n-1，共n次；每次position增加10并打印，体现累计位置。n=0时range(0)为空，无循环。"
      },
      {
        "id": "example_while",
        "title": "演示2：到达目标距离",
        "kind": "example",
        "code": "target = int(input())\nposition = 0\nwhile position < target:\n    position += 10\nprint(position)\n",
        "tests": [
          {
            "stdin": "0",
            "expected": "0"
          },
          {
            "stdin": "25",
            "expected": "30"
          },
          {
            "stdin": "10",
            "expected": "10"
          },
          {
            "stdin": "1",
            "expected": "10"
          }
        ],
        "explanation": "初始化position=0；条件position<target保证未达目标才继续；每次+10更新位置；n=0时条件假，直接输出0。"
      },
      {
